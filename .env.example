# Porta do Servidor Express
PORTA=3000

# Conexão com o Banco de Dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/mvpagenda?schema=public"

# Chave Secreta para Geração de Tokens JWT
JWT_SECRET="insira_aqui_uma_chave_hash_secreta_e_longa_para_producao"

# Chave Secreta para Painel Administrativo de Desbloqueio
ADMIN_SECRET="insira_aqui_sua_chave_secreta_de_admin"

# Configurações de SMTP para Envio de E-mails Transacionais (OTP / 2FA)
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT=587
SMTP_USER="seu-usuario-smtp"
SMTP_PASS="sua-senha-smtp"
SMTP_FROM='"MVP Agenda" <nao-responda@mvpagenda.com>'
